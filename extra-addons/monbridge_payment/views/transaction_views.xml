<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_monbridge_transaction_list" model="ir.ui.view">
        <field name="name">monbridge.transaction.list</field>
        <field name="model">monbridge.transaction</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="payment_id"/>
                <field name="execution_reference"/>
                <field name="executed_at"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="provider"/>
            </list>
        </field>
    </record>
    <record id="view_monbridge_transaction_form" model="ir.ui.view">
        <field name="name">monbridge.transaction.form</field>
        <field name="model">monbridge.transaction</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <h1><field name="name"/></h1>
                    <group>
                        <field name="name"/>
                        <field name="payment_id"/>
                        <field name="execution_reference"/>
                        <field name="executed_at"/>
                        <field name="amount"/>
                        <field name="currency_id"/>
                        <field name="state"/>
                        <field name="provider"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_monbridge_transaction" model="ir.actions.act_window">
        <field name="name">Transactions</field>
        <field name="res_model">monbridge.transaction</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
