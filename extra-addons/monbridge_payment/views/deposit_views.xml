<odoo>
    <record id="view_monbridge_deposit_list" model="ir.ui.view">
        <field name="name">monbridge.deposit.list</field>
        <field name="model">monbridge.deposit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="deposit_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_monbridge_deposit_form" model="ir.ui.view">
        <field name="name">monbridge.deposit.form</field>
        <field name="model">monbridge.deposit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <h1><field name="name"/></h1>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="amount"/>
                        <field name="currency_id"/>
                        <field name="deposit_date"/>
                        <field name="state"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_monbridge_deposit" model="ir.actions.act_window">
        <field name="name">Deposits</field>
        <field name="res_model">monbridge.deposit</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_monbridge_deposit" name="Deposits" parent="menu_monbridge_operations" action="action_monbridge_deposit" sequence="20"/>
</odoo>
