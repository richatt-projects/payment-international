<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_monbridge_beneficiary_list" model="ir.ui.view">
        <field name="name">monbridge.beneficiary.list</field>
        <field name="model">monbridge.beneficiary</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="country_id"/>
                <field name="verification_state"/>
            </list>
        </field>
    </record>
    <record id="view_monbridge_beneficiary_form" model="ir.ui.view">
        <field name="name">monbridge.beneficiary.form</field>
        <field name="model">monbridge.beneficiary</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <h1><field name="name"/></h1>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="country_id"/>
                        <field name="verification_state"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_monbridge_beneficiary" model="ir.actions.act_window">
        <field name="name">Beneficiaries</field>
        <field name="res_model">monbridge.beneficiary</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
