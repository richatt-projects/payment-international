<odoo>
    <record id="view_monbridge_company_list" model="ir.ui.view">
        <field name="name">monbridge.company.list</field>
        <field name="model">monbridge.company</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="country_id"/>
                <field name="state"/>
                <field name="registration_number"/>
            </list>
        </field>
    </record>
    <record id="view_monbridge_company_form" model="ir.ui.view">
        <field name="name">monbridge.company.form</field>
        <field name="model">monbridge.company</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <h1><field name="name"/></h1>
                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="country_id"/>
                        <field name="state"/>
                        <field name="registration_number"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_monbridge_company" model="ir.actions.act_window">
        <field name="name">Companies</field>
        <field name="res_model">monbridge.company</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_monbridge_company" name="Companies" parent="menu_monbridge_operations" action="action_monbridge_company" sequence="20"/>
</odoo>
