<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_monbridge_fx_quote_list" model="ir.ui.view">
        <field name="name">monbridge.fx.quote.list</field>
        <field name="model">monbridge.fx.quote</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="source_currency_id"/>
                <field name="target_currency_id"/>
                <field name="rate"/>
                <field name="valid_until"/>
                <field name="accepted"/>
            </list>
        </field>
    </record>
    <record id="view_monbridge_fx_quote_form" model="ir.ui.view">
        <field name="name">monbridge.fx.quote.form</field>
        <field name="model">monbridge.fx.quote</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <h1><field name="name"/></h1>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="source_currency_id"/>
                        <field name="target_currency_id"/>
                        <field name="rate"/>
                        <field name="valid_until"/>
                        <field name="accepted"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_monbridge_fx_quote" model="ir.actions.act_window">
        <field name="name">FX Quotes</field>
        <field name="res_model">monbridge.fx.quote</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
